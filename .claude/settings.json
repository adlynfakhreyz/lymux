{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run test:e2e)",
      "Bash(npm run demo)",
      "Bash(npx tsc:*)",
      "Bash(npx electron-vite build:*)",
      "Bash(npx electron-builder --linux:*)",
      "Bash(npx electron . --no-sandbox:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git stash:*)"
    ]
  },
  "env": {
    "LYMUX_USER_DATA": "/tmp/lymux-claude-profile"
  }
}
